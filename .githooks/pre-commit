#!/usr/bin/env bash
# Blocks a commit when type-check, lint or the production build fails,
# and when something that looks like a secret is staged.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' >/dev/null; then
  echo "pre-commit: refusing to commit an .env file" >&2; exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -E 'sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY' >/dev/null; then
  echo "pre-commit: staged changes look like they contain a secret" >&2; exit 1
fi
if git diff --cached --name-only | grep -E '^docs/hackprinceton/' >/dev/null; then
  echo "pre-commit: docs/hackprinceton/ must not be committed" >&2; exit 1
fi

[ -d node_modules ] || { echo "pre-commit: run npm install first" >&2; exit 1; }
# Docs-only commits skip the build.
if git diff --cached --name-only | grep -vE '\.(md|txt|png|jpg|gif|json)$|^docs/|^qa/' >/dev/null; then
  npm run --silent typecheck
  npm run --silent lint
  npx vite build --logLevel error
fi
